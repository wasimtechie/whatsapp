# Database (Docker Compose defaults)
DATABASE_URL="postgresql://relay:relay@localhost:5432/relay?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Meta WhatsApp Cloud API (pilot: customer-owned app)
META_APP_ID=""
META_APP_SECRET=""
META_API_VERSION="v21.0"
META_EMBEDDED_SIGNUP_CONFIG_ID=""

# Redis (queue coordination — Phase 1 reserved)
REDIS_URL="redis://localhost:6379"

# Stripe subscription checkout. Price ids are from the Stripe dashboard.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""

# Comma-separated emails that can open /app/admin
PLATFORM_ADMIN_EMAILS=""

# Protects POST /api/cron/campaigns, which sends scheduled broadcasts that are due
CRON_SECRET=""
