generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLATFORM_ADMIN
  OWNER
  MANAGER
  AGENT
  ANALYST
}

enum WorkspaceLifecycle {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum InviteState {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum NumberHealth {
  UNKNOWN
  CONNECTED
  DEGRADED
  DISCONNECTED
  RESTRICTED
}

enum ConversationState {
  OPEN
  PENDING
  RESOLVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum RecipientStatus {
  QUEUED
  SUPPRESSED
  ACCEPTED
  DELIVERED
  READ
  FAILED
  OPTED_OUT
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String
  mfaEnabled   Boolean      @default(false)
  mfaSecret    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  sessions     Session[]
  auditLogs    AuditLog[]   @relation("AuditActor")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Workspace {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  plan        String             @default("trial")
  region      String             @default("in")
  locale      String             @default("en-IN")
  timezone    String             @default("Asia/Kolkata")
  lifecycle   WorkspaceLifecycle @default(TRIAL)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  memberships Membership[]
  numbers     WhatsAppAccount[]
  contacts    Contact[]
  conversations Conversation[]
  messages    Message[]
  templates   Template[]
  campaigns   Campaign[]
  automations AutomationRule[]
  usages      UsageLedger[]
  auditLogs   AuditLog[]
  webhookEvents WebhookEvent[]
  subscription Subscription?
  apiKeys      ApiKey[]
  outboundWebhooks OutboundWebhook[]
}

model Membership {
  id          String      @id @default(cuid())
  userId      String
  workspaceId String
  role        Role        @default(AGENT)
  numberScope String[]    @default([])
  inviteState InviteState @default(ACCEPTED)
  inviteToken String?
  inviteExpiresAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model WhatsAppAccount {
  id              String       @id @default(cuid())
  workspaceId     String
  displayName     String?
  wabaId          String?
  phoneNumberId   String
  displayPhone    String?
  credentialRef   String?
  accessTokenEnc  String?
  webhookVerifyToken String?
  health          NumberHealth @default(UNKNOWN)
  qualityRating   String?
  messagingLimit  String?
  webhookSubscribed Boolean    @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations   Conversation[]
  messages        Message[]
  campaigns       Campaign[]

  @@unique([workspaceId, phoneNumberId])
  @@index([workspaceId])
}

model Contact {
  id              String    @id @default(cuid())
  workspaceId     String
  phoneE164       String
  profileName     String?
  customFields    Json      @default("{}")
  tags            String[]  @default([])
  source          String?
  categoryPerms   String[]  @default([])
  consentSource   String?
  consentAt       DateTime?
  consentEvidence String?
  suppressed      Boolean   @default(false)
  suppressedAt    DateTime?
  suppressedReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations   Conversation[]
  campaignRecipients CampaignRecipient[]

  @@unique([workspaceId, phoneE164])
  @@index([workspaceId, suppressed])
}

model Conversation {
  id              String            @id @default(cuid())
  workspaceId     String
  numberId        String
  contactId       String
  assigneeId      String?
  state           ConversationState @default(OPEN)
  priority        Int               @default(0)
  labels          String[]          @default([])
  lastCustomerAt  DateTime?
  lastMessageAt   DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  number          WhatsAppAccount   @relation(fields: [numberId], references: [id], onDelete: Cascade)
  contact         Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages        Message[]

  @@unique([workspaceId, numberId, contactId])
  @@index([workspaceId, state, lastMessageAt])
}

model Message {
  id              String           @id @default(cuid())
  workspaceId     String
  conversationId  String
  numberId        String
  providerId      String?
  direction       MessageDirection
  status          MessageStatus    @default(QUEUED)
  body            String?
  mediaType       String           @default("text") // text, image, video, audio, document, location, contact, sticker, template, reaction
  mediaRef        String?
  mediaMeta       Json             @default("{}")
  replyToId       String?
  reactions       Json             @default("[]")
  templateName    String?
  deletedAt       DateTime?
  errorCode       String?
  errorMessage    String?
  idempotencyKey  String?
  rawEventId      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation    Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  number          WhatsAppAccount  @relation(fields: [numberId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, conversationId, createdAt])
  @@index([providerId])
}

model Template {
  id              String    @id @default(cuid())
  workspaceId     String
  name            String
  language        String
  category        String?
  status          String    @default("PENDING")
  components      Json      @default("[]")
  providerId      String?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns       Campaign[]

  @@unique([workspaceId, name, language])
  @@index([workspaceId, status])
}

model Campaign {
  id              String         @id @default(cuid())
  workspaceId     String
  numberId        String
  templateId      String
  name            String
  status          CampaignStatus @default(DRAFT)
  segmentSnapshot Json           @default("{}")
  variableMap     Json           @default("{}")
  scheduledAt     DateTime?
  timezone        String         @default("Asia/Kolkata")
  estimatedCost   Decimal?       @db.Decimal(12, 4)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  number          WhatsAppAccount @relation(fields: [numberId], references: [id], onDelete: Cascade)
  template        Template       @relation(fields: [templateId], references: [id], onDelete: Restrict)
  recipients      CampaignRecipient[]

  @@index([workspaceId, status])
}

model CampaignRecipient {
  id           String          @id @default(cuid())
  campaignId   String
  contactId    String
  status       RecipientStatus @default(QUEUED)
  providerId   String?
  failureReason String?
  sentAt       DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  campaign     Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact      Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
}

model AutomationRule {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  priority    Int      @default(100)
  enabled     Boolean  @default(true)
  testMode    Boolean  @default(false)
  trigger     Json
  actions     Json
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, enabled, priority])
}

model Subscription {
  id               String   @id @default(cuid())
  workspaceId      String   @unique
  stripeCustomerId String?
  stripeSubId      String?
  plan             String   @default("trial")
  seats            Int      @default(3)
  numbersLimit     Int      @default(1)
  status           String   @default("trialing")
  currentPeriodEnd DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model UsageLedger {
  id          String   @id @default(cuid())
  workspaceId String
  kind        String
  quantity    Int      @default(1)
  amountInr   Decimal? @db.Decimal(12, 4)
  meta        Json     @default("{}")
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, kind, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String?
  actorId     String?
  action      String
  reason      String?
  meta        Json     @default("{}")
  createdAt   DateTime @default(now())
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actor       User?      @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  keyHash     String    @unique
  prefix      String
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model OutboundWebhook {
  id          String   @id @default(cuid())
  workspaceId String
  url         String
  secret      String
  events      String[] @default(["message.inbound"])
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries  OutboundWebhookDelivery[]

  @@index([workspaceId])
}

model OutboundWebhookDelivery {
  id         String   @id @default(cuid())
  webhookId  String
  event      String
  statusCode Int?
  ok         Boolean  @default(false)
  error      String?
  createdAt  DateTime @default(now())
  webhook    OutboundWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
}

model WebhookEvent {
  id             String   @id @default(cuid())
  workspaceId    String?
  provider       String   @default("meta")
  idempotencyKey String   @unique
  signatureValid Boolean  @default(false)
  payload        Json
  processedAt    DateTime?
  createdAt      DateTime @default(now())
  workspace      Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}
